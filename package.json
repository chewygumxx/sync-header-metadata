{
    "name": "sync-header-metadata",
    "description": "Checks and updates the \"~owner/repo.git\" and \"::: :/<path>\" header lines in tracked files.",
    "version": "2.4.0",
    "license": "GPL-3.0-only",
    "keywords": [
        "cli",
        "github-actions",
        "header",
        "metadata",
        "repository"
    ],
    "homepage": "https://github.com/chewygumxx/sync-header-metadata#readme",
    "bugs": "https://github.com/chewygumxx/sync-header-metadata/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/chewygumxx/sync-header-metadata.git"
    },
    "engines": {
        "bun": ">=1.4",
        "node": ">=24"
    },
    "bin": {
        "sync-header-metadata": "bin/sync-header-metadata.js"
    },
    "files": [
        "bin/",
        "src/",
        "default.gitattributes"
    ],
    "publishConfig": {
        "provenance": true
    },
    "devDependencies": {
        "@biomejs/biome": "2.5.14",
        "@chewygumxx/biome-config": "^1.0.0",
        "@chewygumxx/commitlint-config": "^1.0.0",
        "@chewygumxx/cz-commitlint": "^1.0.2",
        "@chewygumxx/remark-preset": "^1.0.3",
        "@chewygumxx/yamllint-config": "^1.0.0",
        "@commitlint/cli": "^21.2.2",
        "@types/bun": "^1.4.2",
        "commitizen": "^4.3.2",
        "husky": "^9.1.7",
        "prettier": "^3.9.9",
        "remark-cli": "^12.0.1",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "check": "bun run typecheck && bun run lint:biome && bun run lint:md && bun run lint:yaml && bun run lint:emdash && bun run test",
        "commit": "cz",
        "format": "biome format --write . && bun run format:yaml",
        "format:check": "biome format .",
        "format:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --write --log-level warn",
        "lint": "biome lint .",
        "lint:biome": "biome ci .",
        "lint:emdash": "git grep -nIP --untracked '\\x{2014}'; test $? -eq 1",
        "lint:md": "git ls-files -z '*.md' | xargs -0 -r remark --frail --quiet --no-stdout",
        "lint:yaml": "git ls-files -z '*.yaml' '*.yml' | xargs -0 -r prettier --check && git ls-files -z '*.yaml' '*.yml' | xargs -0 -r yamllint --strict",
        "prepare": "test -d node_modules/husky && husky || true",
        "test": "bun test",
        "typecheck": "tsc"
    },
    "config": {
        "commitizen": {
            "path": "@chewygumxx/cz-commitlint"
        }
    },
    "remarkConfig": {
        "plugins": [
            "@chewygumxx/remark-preset"
        ]
    }
}
